{
  "name": "postcards",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:postgres": "node --env-file-if-exists=.env.local --experimental-strip-types --test tests/integration/sharing-postgres.test.mjs",
    "test:http": "node --env-file-if-exists=.env.local --experimental-strip-types --test tests/integration/sharing-http.test.mjs",
    "db:setup": "node --env-file=.env.local scripts/setup-db.mjs",
    "db:shares": "node --env-file-if-exists=.env.local scripts/setup-shares.mjs"
  },
  "dependencies": {
    "next": "16.3.5",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "swr": "^2.5.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
