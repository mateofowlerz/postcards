# Sample data is the default for the gallery. Sharing uses DATABASE_URL when set.
POSTCARDS_DATA_SOURCE=sample
# Supabase: use the Transaction pooler connection string from the Connect dialog.
# DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@POOLER_HOST:6543/postgres?sslmode=verify-full
# Base64-encode Supabase's downloaded CA certificate to verify its server certificate.
# DATABASE_CA_CERT_BASE64=...
# Short links require DATABASE_URL in production, even with a sample gallery.
# Run npm run db:shares to create only the sharing table (no gallery seed).
# Local development without DATABASE_URL stores shares in .data/shared-postcards.

# Google Analytics 4 measurement ID. Analytics stays disabled when this is unset.
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
